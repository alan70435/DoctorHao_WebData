---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleListPage from '@/components/ArticleListPage.astro';
import Icon from '@/components/Icon.astro';
import { topics, type Topic } from '@/data/topics';
import { treatmentBySlug } from '@/data/treatments';
import { getArticlesByTags } from '@/lib/articles';
import { breadcrumbJsonLd } from '@/lib/jsonld';

export function getStaticPaths() {
  return topics.map((t) => ({ params: { topic: t.id }, props: { topic: t } }));
}
interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const articles = await getArticlesByTags(topic.tags);
const crumbs = [{ label: '程皓醫師專欄', href: '/articles/' }, { label: `主題：${topic.name}` }];
const related = (topic.treatments ?? []).map((s) => treatmentBySlug[s as keyof typeof treatmentBySlug]).filter(Boolean);
---

<BaseLayout
  title={`${topic.name}相關文章`}
  description={`程皓醫師關於「${topic.name}」（${topic.description}）的衛教文章整理，以及可能相關的治療說明。`}
  jsonLd={breadcrumbJsonLd(Astro.site, crumbs)}
>
  <ArticleListPage
    eyebrow="從問題開始找資訊"
    title={topic.name}
    lede={`${topic.description}。以下是程皓醫師曾分享過的相關內容；若有持續症狀，仍建議實際就診評估。`}
    crumbs={crumbs}
    articles={articles}
    showCategoryNav={false}
    emptyMessage="這個主題的文章整理中，可先瀏覽專欄總覽。"
  >
    {
      related.length > 0 && (
        <aside class="topic-treatments" aria-labelledby="topic-treatments-title">
          <h2 id="topic-treatments-title">可能相關的治療說明</h2>
          <ul>
            {related.map((t) => (
              <li>
                <a href={`/${t.slug}/`} class="card card--link topic-treatment">
                  <span class="topic-treatment__name">{t.name}</span>
                  <span class="topic-treatment__en">{t.englishName}</span>
                  <Icon name="arrow-right" class="icon" />
                </a>
              </li>
            ))}
          </ul>
          <p class="topic-treatments__note">是否適合任何治療，皆需經醫師實際診察評估。</p>
        </aside>
      )
    }
    <p class="topic-back"><a href="/">← 回首頁看其他主題</a></p>
  </ArticleListPage>
</BaseLayout>

<style>
  .topic-treatments {
    margin-top: var(--sp-12);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--c-line);
  }
  .topic-treatments h2 {
    font-size: var(--fs-lg);
    margin-bottom: var(--sp-4);
  }
  .topic-treatments ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .topic-treatments li {
    margin: 0;
  }
  .topic-treatment {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2px var(--sp-3);
    padding: var(--sp-4) var(--sp-5);
    text-decoration: none;
    color: var(--c-ink);
  }
  .topic-treatment__name {
    font-weight: 700;
  }
  .topic-treatment__en {
    grid-column: 1;
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .topic-treatment :global(.icon) {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--c-brand-500);
  }
  .topic-treatments__note {
    margin-top: var(--sp-3);
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .topic-back {
    margin-top: var(--sp-8);
    font-size: var(--fs-sm);
  }
</style>
