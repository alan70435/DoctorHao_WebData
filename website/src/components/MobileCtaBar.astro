---
import Icon from './Icon.astro';
const current = Astro.url.pathname;
const onClinic = current.startsWith('/clinic');
---

{
  !onClinic && (
    <div class="mobile-cta" role="region" aria-label="快速前往門診資訊">
      <a href="/clinic/" class="btn btn--block">
        <Icon name="calendar" class="icon" />
        查看門診時間及預約
      </a>
    </div>
  )
}

<style>
  .mobile-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 90;
    padding: 10px clamp(1rem, 4vw, 2rem) calc(10px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--c-line);
  }
  @media (min-width: 900px) {
    .mobile-cta {
      display: none;
    }
  }
</style>
