---
/**
 * 專欄列表共用版面（總覽／分類／主題）。
 */
import { Image } from 'astro:assets';
import Breadcrumb from './Breadcrumb.astro';
import ArticleCard from './ArticleCard.astro';
import SectionHead from './SectionHead.astro';
import { categoryList, type CategoryId } from '@/data/categories';
import type { Article } from '@/lib/articles';
import { generatedCategoryBanner } from '@/lib/generated';
import { categoryIllustration } from '@/data/visualKit';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  crumbs: { label: string; href?: string }[];
  articles: Article[];
  activeCategory?: CategoryId | 'all';
  /** 顯示分類切換 */
  showCategoryNav?: boolean;
  emptyMessage?: string;
  /** 主題入口頁的圖示（/visual-kit/topics/*.svg） */
  topicIcon?: string;
}
const { eyebrow, title, lede, crumbs, articles, activeCategory = 'all', showCategoryNav = true, emptyMessage = '目前尚無文章。', topicIcon } = Astro.props;
/** 分類頁視覺：生成橫幅優先，否則 SVG 插畫 */
const banner = activeCategory !== 'all' ? generatedCategoryBanner(activeCategory) : undefined;
const illustration = activeCategory !== 'all' ? categoryIllustration(activeCategory) : undefined;
---

<section class="list-head">
  <div class="container">
    <Breadcrumb items={crumbs} />
    <div class:list={['list-head__body', { 'list-head__body--visual': !!(illustration || topicIcon) }]}>
      <div>
        {topicIcon && <img src={topicIcon} alt="" width="72" height="72" class="list-head__topic-icon" />}
        <SectionHead eyebrow={eyebrow} title={title} lede={lede} as="h1" />
      {
        showCategoryNav && (
          <nav class="cat-nav" aria-label="專欄分類">
            <a href="/articles/" class:list={['cat-nav__link', { 'is-active': activeCategory === 'all' }]} aria-current={activeCategory === 'all' ? 'page' : undefined}>
              全部
            </a>
            {categoryList.map((c) => (
              <a href={c.path} class:list={['cat-nav__link', { 'is-active': activeCategory === c.id }]} aria-current={activeCategory === c.id ? 'page' : undefined}>
                {c.name}
              </a>
            ))}
          </nav>
        )
      }
      </div>
      {
        illustration && (
          <div class="list-head__visual">
            {banner ? (
              <Image src={banner} alt="" widths={[480, 720, 960]} sizes="(min-width: 900px) 420px, 92vw" loading="eager" class="list-head__img" />
            ) : (
              <img src={illustration} alt="" width="600" height="400" loading="eager" class="list-head__img" />
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<section class="section section--tight" aria-label="文章列表">
  <div class="container">
    <p class="list-count">共 {articles.length} 篇</p>
    {
      articles.length > 0 ? (
        <div class="grid grid--3">
          {articles.map((a, i) => (
            <ArticleCard article={a} headingLevel="h2" loading={i < 3 ? 'eager' : 'lazy'} />
          ))}
        </div>
      ) : (
        <p class="list-empty">{emptyMessage}</p>
      )
    }
    <slot />
  </div>
</section>

<style>
  .list-head {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem);
    background: linear-gradient(180deg, #fff 0%, var(--c-surface) 100%);
    border-bottom: 1px solid var(--c-line);
  }
  .list-head__body {
    margin-top: var(--sp-5);
  }
  .list-head__body--visual {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
  }
  @media (min-width: 900px) {
    .list-head__body--visual {
      grid-template-columns: 1.3fr 0.9fr;
      gap: var(--sp-12);
    }
  }
  .list-head__topic-icon {
    width: 72px;
    height: 72px;
    border-radius: 20px;
    margin-bottom: var(--sp-4);
  }
  .list-head__visual :global(.list-head__img) {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--r-xl);
    margin-inline: auto;
  }
  .list-head :global(.section-head) {
    margin-bottom: var(--sp-5);
  }
  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .cat-nav__link {
    padding: 8px 14px;
    border-radius: var(--r-pill);
    border: 1px solid var(--c-line-strong);
    background: #fff;
    color: var(--c-text);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .cat-nav__link:hover {
    border-color: var(--c-brand-500);
    color: var(--c-brand-700);
  }
  .cat-nav__link.is-active {
    background: var(--c-brand-700);
    border-color: var(--c-brand-700);
    color: #fff;
  }
  .list-count {
    font-size: var(--fs-xs);
    color: var(--c-muted);
    margin-bottom: var(--sp-5);
  }
  .list-empty {
    color: var(--c-muted);
  }
</style>
