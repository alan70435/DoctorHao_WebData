---
import Icon from './Icon.astro';
import { sessionTimes, weekdays, type Clinic } from '@/data/clinics';

interface Props {
  clinic: Clinic;
  /** 精簡版（首頁） */
  compact?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { clinic: c, compact = false, headingLevel: H = 'h3' } = Astro.props;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(c.mapQuery)}`;
const days = weekdays.filter((d) => c.schedule[d]?.length);
const label = (s: keyof typeof sessionTimes) => sessionTimes[s].label;
---

<article class:list={['ccard card', { 'ccard--primary': c.primary, 'ccard--compact': compact }]}>
  <div class="ccard__head">
    <div>
      <p class="ccard__city">{c.city}</p>
      <H class="ccard__title">{c.name}<span class="ccard__dept">{c.department}</span></H>
    </div>
    {c.primary && <span class="chip chip--teal">主要門診</span>}
  </div>

  <ul class="ccard__schedule" aria-label={`${c.name} 門診時段`}>
    {
      days.map((d) => (
        <li>
          <span class="ccard__day">{d}</span>
          <span class="ccard__sessions">
            {c.schedule[d]!.map((s) => (
              <span class="ccard__session">
                {label(s)}
                {!compact && <small>{sessionTimes[s].time}</small>}
              </span>
            ))}
          </span>
        </li>
      ))
    }
  </ul>

  <ul class="ccard__meta">
    <li>
      <Icon name="map-pin" class="icon" />
      <a href={mapUrl} target="_blank" rel="noopener noreferrer">{c.address}<span class="visually-hidden">（Google 地圖，另開新視窗）</span></a>
    </li>
    {
      c.phone && (
        <li>
          <Icon name="phone" class="icon" />
          <a href={`tel:${c.phone.replace(/-/g, '')}`}>{c.phone}</a>
          {c.phoneNote && <span class="ccard__note">（{c.phoneNote}）</span>}
        </li>
      )
    }
  </ul>

  {
    !compact && c.notes && (
      <ul class="ccard__notes">
        {c.notes.map((n) => <li>{n}</li>)}
      </ul>
    )
  }

  <div class="ccard__actions">
    {
      c.registrationUrl && (
        <a href={c.registrationUrl} class="btn" target="_blank" rel="noopener noreferrer">
          {c.registrationLabel ?? '前往院方掛號'} <Icon name="external" class="icon" />
        </a>
      )
    }
    {
      c.lineUrl && (
        <a href={c.lineUrl} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">
          {c.registrationLabel ?? 'LINE 預約'} <Icon name="external" class="icon" />
        </a>
      )
    }
  </div>
</article>

<style>
  .ccard {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-6);
    height: 100%;
  }
  .ccard--primary {
    border-color: var(--c-brand-300);
    box-shadow: var(--shadow-sm);
  }
  .ccard__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-3);
  }
  .ccard__city {
    margin: 0 0 2px;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--c-brand-600);
  }
  .ccard__title {
    margin: 0;
    font-size: var(--fs-lg);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2);
  }
  .ccard__dept {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--c-muted);
  }
  .ccard__schedule {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }
  .ccard__schedule li {
    display: grid;
    grid-template-columns: 3.2em 1fr;
    gap: var(--sp-3);
    align-items: start;
    margin: 0;
    padding: var(--sp-2) 0;
    border-bottom: 1px dashed var(--c-line);
  }
  .ccard__day {
    font-weight: 700;
    color: var(--c-ink);
  }
  .ccard__sessions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .ccard__session {
    display: inline-flex;
    flex-direction: column;
    padding: 4px 10px;
    border-radius: var(--r-sm);
    background: var(--c-brand-50);
    color: var(--c-brand-800);
    font-weight: 600;
    font-size: var(--fs-sm);
    line-height: 1.3;
  }
  .ccard__session small {
    font-weight: 400;
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .ccard--compact .ccard__session {
    flex-direction: row;
  }
  .ccard__meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
  }
  .ccard__meta li {
    display: flex;
    gap: var(--sp-2);
    align-items: flex-start;
    margin: 0;
    flex-wrap: wrap;
  }
  .ccard__meta :global(.icon) {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--c-brand-500);
    margin-top: 0.2em;
  }
  .ccard__meta a {
    color: var(--c-text);
  }
  .ccard__note {
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }
  .ccard__notes {
    margin: 0;
    padding-left: 1.2em;
    font-size: var(--fs-xs);
    color: var(--c-muted);
    line-height: 1.7;
  }
  .ccard__notes li {
    margin-bottom: var(--sp-1);
  }
  .ccard__actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    padding-top: var(--sp-2);
  }
  .ccard__actions .btn {
    flex: 1 1 auto;
  }
</style>
