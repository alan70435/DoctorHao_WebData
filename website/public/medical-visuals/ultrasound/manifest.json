    {
      "id": "ankle",
      "name": "踝關節",
      "target": "阿基里斯腱・跟骨附著處",
      "alt": "主模型為後外側概念視角，足部姿勢不是病人擺位指令；示範肌腱連續走向，不呈現合成超音波影像。",
      "position": [
        "俯臥，小腿有支撐，足部伸出床緣。",
        "以舒適範圍調整足部，避免強迫背屈。"
      ],
      "windows": [
        [
          "前方",
          "脛前肌、伸肌腱與踝前方隱窩"
        ],
        [
          "外側",
          "腓骨肌腱、前距腓韌帶與跟腓韌帶"
        ],
        [
          "內側",
          "脛後肌腱、屈肌腱與跗管"
        ],
        [
          "後方",
          "阿基里斯腱及周邊滑囊"
        ],
        [
          "足底延伸",
          "足底筋膜的跟骨附著處"
        ]
      ],
      "caution": [
        "從肌腱肌肉交界追至跟骨附著處，取得長、短軸。",
        "附著處需微調入射角；低回音不應直接等同肌腱斷裂。"
      ],
