    {
      "id": "hip",
      "name": "髖關節",
      "target": "前方關節隱窩・股骨頭頸",
      "alt": "成人前髖示意；斜長軸以股骨頭、股骨頸定位。不是嬰兒髖發育評估，也不能據此排除盂唇病變。",
      "position": [
        "成人仰躺，以下肢舒適姿勢檢查。",
        "較深部位依穿透需求選擇較低頻探頭。"
      ],
      "windows": [
        [
          "前方",
          "股骨頭頸、前方隱窩與髂腰肌腱"
        ],
        [
          "外側",
          "大轉子、臀中肌與臀小肌腱"
        ],
        [
          "內側",
          "內收肌起點及周邊軟組織"
        ],
        [
          "後方",
          "坐骨結節與近端腿後肌腱"
        ]
      ],
      "caution": [
        "前方主視窗沿股骨頸斜長軸，不是直接沿大腿長軸。",
        "先辨識內側神經血管；藍色囊線不是積液或疾病的判定。"
      ],
