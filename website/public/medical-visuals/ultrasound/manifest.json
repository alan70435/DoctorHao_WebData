  "items": [
    {
      "id": "shoulder",
      "name": "肩關節",
      "target": "肱二頭肌長頭肌腱・結節間溝",
      "alt": "以結節間溝為骨性地標辨識肱二頭肌長頭肌腱；此圖不等於完整旋轉肌袖檢查。",
      "position": [
        "坐姿，肘彎曲約 90°，掌心向上。",
        "前臂朝對側膝，肩採輕度內旋。"
      ],
      "windows": [
        [
          "前方",
          "肱二頭肌長頭肌腱；肩胛下肌腱"
        ],
        [
          "上外側",
          "棘上肌腱與肩峰下－三角肌下滑囊"
        ],
        [
          "後方",
          "棘下肌、小圓肌腱與後方關節隱窩"
        ],
        [
          "肩頂",
          "肩鎖關節"
        ]
      ],
      "caution": [
        "先以短軸找到大、小結節間的肌腱，再轉長軸。",
        "旋轉探頭不等於任意壓迫；輕微傾斜以調整各向異性。"
      ],
      "models": {
        "long": "shoulder-long.glb",
        "short": "shoulder-short.glb"
      },
      "camera": [
        0.46365,
        0.30919
      ],
