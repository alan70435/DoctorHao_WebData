    {
      "id": "knee",
      "name": "膝關節",
      "target": "髕骨下極・髕腱・脛骨粗隆",
      "alt": "以髕腱為主要示範，髕骨未移開；骨形、軟組織厚度與間隙均為概念比例，不能量測或判讀病變。",
      "position": [
        "仰躺，膝下墊枕，微屈約 20–30°。",
        "依舒適度與檢查目的調整支撐。"
      ],
      "windows": [
        [
          "前方",
          "股四頭肌腱、髕上隱窩與髕腱"
        ],
        [
          "內側",
          "內側副韌帶與鵝足肌腱"
        ],
        [
          "外側",
          "髂脛束、外側副韌帶與股二頭肌腱"
        ],
        [
          "後方",
          "膕窩、半膜肌與內側腓腸肌間區域"
        ]
      ],
      "caution": [
        "長軸從髕骨下極追到脛骨粗隆；短軸需涵蓋肌腱全寬。",
        "前方超音波不能單獨完整排除十字韌帶或半月板病變。"
      ],
