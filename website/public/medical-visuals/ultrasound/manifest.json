    {
      "id": "elbow",
      "name": "肘關節",
      "target": "外上髁・共同伸肌腱",
      "alt": "外上髁是共同伸肌腱的近端骨性地標；本視窗不取代前、內、後側的適應症導向評估。",
      "position": [
        "坐姿，上肢有支撐，拇指朝上。",
        "肘可伸直或採舒適屈曲位，露出外側。"
      ],
      "windows": [
        [
          "前方",
          "遠端肱二頭肌腱、肱肌與神經血管"
        ],
        [
          "外側",
          "共同伸肌腱、橈肱關節與橈神經分支"
        ],
        [
          "內側",
          "共同屈肌腱與尺側副韌帶"
        ],
        [
          "後方",
          "肱三頭肌腱、鷹嘴隱窩與尺神經"
        ]
      ],
      "caution": [
        "探頭近端置於外上髁，順肌腱方向取得長軸。",
        "同時取得短軸；深層韌帶與表層肌腱不可混為一談。"
      ],
      "models": {
        "long": "elbow-long.glb",
        "short": "elbow-short.glb"
      },
